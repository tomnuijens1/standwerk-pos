<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12+: niets van deze app meenemen in cloud-backups of bij een
     toestel-naar-toestel-overdracht. De app bewaart lokaal wie is ingelogd en
     welke bon in opbouw is; dat hoort apparaatgebonden te blijven. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
        <exclude domain="file" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
        <exclude domain="file" />
    </device-transfer>
</data-extraction-rules>
